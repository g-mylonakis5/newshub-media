# Οι απομαγνητοφωνήσεις που σερβίρονται στον browser. Παράγονται από το
# data/transcripts/ σε κάθε build — δεν τις κρατάμε δύο φορές.
public/transcript/

# Το ευρετήριο αναζήτησης — παράγεται από το Pagefind μετά το build.
public/pagefind/

# Ο καιρός αλλάζει κάθε μέρα. Αν λείπει, η λωρίδα δείχνει μόνο τα σόσιαλ.
data/weather.json

# ΔΕΝ αγνοούμε το υπόλοιπο data/:
#   people-aliases.json, curation.json  — γραμμένα με το χέρι
#   news.json                           — ΣΥΣΣΩΡΕΥΤΙΚΟ, χάνεται ιστορικό
#   videos.json                         — θέλει YOUTUBE_API_KEY για να ξαναγίνει
#   transcripts/                        — 20MB που κατεβαίνουν μία φορά

# Ρυθμίσεις του εργαλείου, όχι του project: έχουν απόλυτες διαδρομές
# αυτού του μηχανήματος και δεν δουλεύουν αλλού.
.claude/

