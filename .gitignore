# Μυστικά — ΠΟΤΕ δεν ανεβαίνουν πουθενά.
.env
.env.*
!.env.example

# ---- public/ ----
#
# Το Cloudflare τρέχει μόνο του «npm run build», άρα ΟΛΟ το public/
# παράγεται εκεί. Δεν το ανεβάζουμε: 8.682 αρχεία που ξαναγράφονται
# σε κάθε deployment, και το Pages δέχεται έως 20.000.
#
# Η λογική είναι ανάποδη επίτηδες — αγνοούμε τα πάντα και ξεχωρίζουμε
# μόνο τα πηγαία. Έτσι κάθε νέος παραγόμενος φάκελος μένει εκτός από
# μόνος του, χωρίς να θυμηθεί κανείς να τον προσθέσει εδώ.
public/*
!public/styles.css
!public/player.js
# Γραμμένο με το χέρι, όπως ο player — δεν το παράγει το build.js.
# Χωρίς αυτή τη γραμμή το Cloudflare χτίζει σελίδα που ζητά ένα
# roi.js που δεν ανέβηκε ποτέ, και η ροή μένει παγωμένη στο χτίσιμο.
!public/roi.js
!public/favicon.svg
!public/intro.jpg
!public/*.jpg
!public/*.jpeg
!public/*.png
!public/*.webp
!public/shows/

data/weather.json

# ΔΕΝ αγνοούμε το υπόλοιπο data/:
#   people-aliases.json, curation.json  — γραμμένα με το χέρι
#   news.json                           — ΣΥΣΣΩΡΕΥΤΙΚΟ, χάνεται ιστορικό
#   videos.json                         — θέλει YOUTUBE_API_KEY για να ξαναγίνει
#   transcripts/                        — 20MB που κατεβαίνουν μία φορά

# Ρυθμίσεις του εργαλείου, όχι του project: έχουν απόλυτες διαδρομές
# αυτού του μηχανήματος και δεν δουλεύουν αλλού.
.claude/

# Τα πρωτότυπα των εξωφύλλων, όπως τα δίνει ο σχεδιαστής: 2–4MB το ένα.
# Στο site μπαίνουν συμπιεσμένα, στο public/show-art/ — εκείνα ΑΝΕΒΑΙΝΟΥΝ,
# δεν παράγονται από τίποτα.
assets-src/

# Node
node_modules/
npm-debug.log*

# Windows / editors
Thumbs.db
Desktop.ini
.DS_Store

# Οι φωτογραφίες που ανεβάζουν οι δημοσιογράφοι. ΔΕΝ μπαίνουν στο git:
# τα binary μένουν στο ιστορικό για πάντα και το Cloudflare Pages δέχεται
# 20.000 αρχεία — το public/ έχει ήδη 9.726. Στον αέρα ζουν σε R2.
#
# Ο κάθετος μπροστά είναι ΑΠΑΡΑΙΤΗΤΟΣ. Χωρίς αυτόν το git αγνοεί κάθε
# φάκελο «uploads» σε όποιο βάθος — και έτρωγε το functions/uploads/,
# τη συνάρτηση που σερβίρει τις φωτογραφίες από το R2. Αποτέλεσμα: οι
# φωτογραφίες ανέβαιναν κανονικά αλλά καμία δεν φαινόταν στο site.
/uploads/

# Παράγεται από το build.js για το διαχειριστικό: 4.800 εγγραφές
# που ξαναγράφονται σε κάθε build.
admin/auto-categories.json
admin/people.json
admin/pairs-todo.json
admin/topics.json

# Τα μυστικά του wrangler για τοπική δοκιμή — ΠΟΤΕ στο git.
.dev.vars
.dev.vars.*
.wrangler/
