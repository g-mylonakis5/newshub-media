#!/bin/sh
# pre-commit — κρατάει τα παραγόμενα δεδομένα έξω από τα δικά μας commits.
#
# Το data/news.json το ξαναγράφει ΟΛΟΚΛΗΡΟ το GitHub Action «Φρέσκο υλικό»
# πολλές φορές τη μέρα (.github/workflows/fetch.yml). Είναι ένα αρχείο με
# 600 άρθρα, οπότε κάθε φορά που το κομμιτάρουμε κι εμείς, το git βρίσκει
# δύο πλευρές που άλλαξαν τις ίδιες γραμμές και σκάει σε σύγκρουση στο
# επόμενο pull. Έγινε στις 5 Νοεμβρίου 2026.
#
# ΔΕΝ μπαίνει στο .gitignore: το Cloudflare χτίζει από το repo και το
# build.js διαβάζει αυτό το αρχείο — χωρίς αυτό, μηδέν ειδήσεις στο site.
# Ιδιοκτήτης του είναι το bot. Εμείς απλώς δεν το αγγίζουμε.
#
# Τα data/news-bodies/ ΜΕΝΟΥΝ: είναι χωριστά αρχεία, ένα ανά άρθρο, και
# δεν συγκρούονται ποτέ. Το bot δεν τα πιάνει πάντα — τα συμπληρώνει το
# τοπικό τρέξιμο του fetch-news.js, οπότε αξίζουν commit.
#
# Στήνεται μία φορά:  git config core.hooksPath .githooks

OWNED_BY_BOT="data/news.json"

removed=0

for file in $OWNED_BY_BOT; do
  # Σκέτο «δεν άλλαξε» -> δεν έχουμε τίποτα να κάνουμε.
  if git diff --cached --quiet -- "$file" 2>/dev/null; then
    continue
  fi

  git restore --staged -- "$file" 2>/dev/null || git reset -q HEAD -- "$file"
  echo "pre-commit: το $file βγήκε από το commit — το ανανεώνει το bot." >&2
  removed=1
done

# Αν μετά την αφαίρεση δεν έμεινε τίποτα, το λέμε καθαρά αντί να βγει το
# σκέτο «nothing to commit» που δεν εξηγεί γιατί.
#
# ΜΟΝΟ αν αφαιρέσαμε κάτι εμείς. Το «άδειο staging» είναι κανονική
# κατάσταση στο git commit --amend, που ξαναγράφει μήνυμα χωρίς νέες
# αλλαγές — το μπλοκάραμε άθελά μας την πρώτη φορά.
if [ "$removed" = "1" ] && git diff --cached --quiet; then
  echo "pre-commit: δεν έμεινε καμία δική μας αλλαγή στο commit." >&2
  echo "            Για να φύγουν και από τον φάκελο:  npm run sync" >&2
  exit 1
fi

# ---- Οι εικόνες ----
#
# Το Cloudflare χτίζει με το push και δεν περιμένει κανέναν έλεγχο. Άρα
# ο ΜΟΝΟΣ τόπος που μπορεί να σταματήσει μια σπασμένη εικόνα πριν βγει
# στον αέρα είναι εδώ, πριν γίνει καν το commit.
#
# Τρέχει μόνο όταν αλλάζει κάτι που μπορεί να χαλάσει εικόνα — στα
# υπόλοιπα commits δεν κοστίζει τίποτα. Θέλει ~1,5 λεπτό: χτίζει το
# site και ανοίγει 21 σελίδες σε δύο πλάτη.
#
# Αν βιάζεσαι:  git commit --no-verify
# Τότε το πιάνει το GitHub Action (.github/workflows/eikones.yml), αλλά
# αφού έχει ήδη βγει στον αέρα.

TOUCHES_IMAGES=$(git diff --cached --name-only --diff-filter=ACM \
  -- public/styles.css public/player.js build.js check-images.js)

if [ -n "$TOUCHES_IMAGES" ]; then
  echo "pre-commit: άλλαξε το CSS/build — μετράω τις εικόνες (~1,5')." >&2

  if ! node build.js > /dev/null 2>&1; then
    echo "pre-commit: το build.js απέτυχε — δεν μπορώ να ελέγξω εικόνες." >&2
    exit 1
  fi

  if ! node check-images.js; then
    echo "" >&2
    echo "pre-commit: ΤΟ COMMIT ΣΤΑΜΑΤΗΣΕ. Κάποια εικόνα μπαίνει λάθος." >&2
    echo "            Διόρθωσε, ή πέρασέ το με:  git commit --no-verify" >&2
    exit 1
  fi
fi

exit 0
